# Copy to .env.local and fill in. Never commit .env.local.

# OpenAI-compatible endpoint. Groq: https://api.groq.com/openai/v1
LLM_BASE_URL=
# Shared server keys, tried in order. LLM_KEY_2 is optional.
LLM_KEY_1=
LLM_KEY_2=

# Local offline mode (Ollama). Only works when running the app locally.
OLLAMA_BASE_URL=http://localhost:11434/v1

# Speech-to-text (optional). If neither is set, the mic button is hidden
# unless the user adds their own key in Settings.
SPEECHMATICS_API_KEY=
ELEVENLABS_API_KEY=
